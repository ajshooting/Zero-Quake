{
  "name": "zeroquake",
  "productName": "Zero Quake",
  "version": "0.9.10",
  "description": "Zero Quake",
  "scripts": {
    "start": "electron . --develop --debug-mode",
    "test": "node --test"
  },
  "build": {
    "productName": "Zero Quake",
    "files": [
      "!CODE_OF_CONDUCT.md",
      "!CONTRIBUTING.md",
      "!SECURITY.md",
      "!PULL_REQUEST_TEMPLATE.md",
      "!tools/*",
      "!eslint.config.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "ZeroQuake-${version}-mac-${arch}.${ext}",
      "icon": "src/img/icon.icns",
      "electronLanguages": [
        "ja",
        "en-US"
      ],
      "files": [
        "!package-lock.json",
        "!build/**",
        "!node_modules/maplibre-gl/{src,test,docs}/**",
        "!**/*.{map,ts,md}",
        "!node_modules/*/{CHANGELOG.md,README.md,*.map,*.ts}",
        "package.json",
        "src/**",
        "node_modules/**",
        "LICENSE.md",
        "THIRD-PARTY-LICENSES.txt",
        "!README.md",
        "!.github/**",
        "!.gitignore",
        "!eslint.config.js",
        "!tools/**",
        "!build/appx/**",
        "!node_modules/maplibre-gl/dist/*-dev.js",
        "!node_modules/**/{test,tests,__tests__,docs,examples,benchmark}/**",
        "!node_modules/d3-geo/img/**",
        "!node_modules/d3-voronoi/*.png",
        "!node_modules/**/prebuilds/{win32-*,linux-*}/**",
        "!src/img/icon.ico",
        "!src/img/tsunami_scale.png",
        "!node_modules/**/*.tsbuildinfo",
        "!node_modules/**/*.{d.ts,d.cts,d.mts}",
        "!node_modules/maplibre-gl/build/**",
        "!node_modules/maplibre-gl/dist/maplibre-gl-csp.js",
        "!node_modules/maplibre-gl/dist/maplibre-gl-csp-worker.js",
        "!node_modules/pmtiles/dist/cjs/**",
        "!node_modules/pmtiles/dist/esm/**",
        "!node_modules/fflate/**",
        "!node_modules/**/doc/**",
        "!node_modules/**/*.html"
      ]
    },
    "win": {
      "icon": "src/img/icon.ico",
      "publish": {
        "provider": "github",
        "owner": "{USER_NAME}"
      },
      "target": {
        "target": "nsis"
      }
    },
    "nsis": {
      "artifactName": "ZeroQuake_Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Zero Quake"
    },
    "appx": {
      "displayName": "Zero Quake",
      "identityName": "Benidate.ZeroQuake",
      "applicationId": "Benidate.ZeroQuake",
      "publisherDisplayName": "Benidate",
      "publisher": "CN=0FCA04CE-D29D-4DB6-BA68-14F151A28AD4",
      "languages": [
        "JA-JP"
      ],
      "backgroundColor": "#202227"
    }
  },
  "type": "module",
  "main": "src/main.js",
  "author": "benidate",
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Quake/Zero-Quake.git"
  },
  "bugs": {
    "url": "https://github.com/0Quake/Zero-Quake/issues"
  },
  "homepage": "https://0quake.github.io/ZeroQuake_Website/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "electron-store": "^12.0.0",
    "eventsource": "^5.1.4",
    "jsdom": "^31.0.0",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0"
  }
}
